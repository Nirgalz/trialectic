{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Nirgalz/trialectic/blob/dev/schemas/proposal-v0/trialectic.schema.json",
  "title": "Trialectic Method normalized analytical exchange format — PROPOSAL 0.1",
  "description": "Experimental structural schema; NOT author-approved Method semantics. Structural validation does not establish causality, sufficiency, actionable Power or empirical truth.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "0.1.0-proposal"
    },
    "analysis_id": {
      "$ref": "#/$defs/id"
    },
    "main_subject": {
      "$ref": "#/$defs/objectRef"
    },
    "secondary_subjects": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/objectRef"
      }
    },
    "focus": {
      "$ref": "#/$defs/focus"
    },
    "environment": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/objectRef"
      }
    },
    "objects": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/object"
      }
    },
    "definitions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/definition"
      }
    },
    "relations": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/relation"
      }
    },
    "conditions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/condition"
      }
    },
    "pathways": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/pathway"
      }
    },
    "inventories": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/inventory"
      }
    },
    "scenarios": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/scenario"
      }
    },
    "events": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/event"
      }
    },
    "condition_assessments": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/conditionAssessment"
      }
    },
    "need_assessments": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/needAssessment"
      }
    },
    "power_assessments": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/powerAssessment"
      }
    },
    "effects": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/effect"
      }
    },
    "claims": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/claim"
      }
    },
    "evidence_items": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/evidence"
      }
    },
    "evidence_reviews": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/evidenceReview"
      }
    },
    "claim_assessments": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/claimAssessment"
      }
    }
  },
  "required": [
    "schema_version",
    "analysis_id",
    "main_subject",
    "objects",
    "definitions",
    "relations",
    "conditions",
    "pathways",
    "inventories",
    "scenarios",
    "events",
    "condition_assessments",
    "need_assessments",
    "power_assessments",
    "effects",
    "claims",
    "evidence_items",
    "evidence_reviews",
    "claim_assessments"
  ],
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9._:-]*$",
      "minLength": 1
    },
    "version": {
      "type": "string",
      "minLength": 1
    },
    "time": {
      "type": "string",
      "format": "date-time",
      "description": "Must include explicit UTC offset; full ISO 8601 and IANA checks are outside basic JSON Schema."
    },
    "status": {
      "enum": [
        "satisfied",
        "unsatisfied",
        "indeterminate"
      ]
    },
    "coverage": {
      "enum": [
        "complete",
        "incomplete",
        "indeterminate"
      ]
    },
    "objectRef": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "version": {
          "$ref": "#/$defs/version"
        }
      },
      "required": [
        "id",
        "version"
      ]
    },
    "relationRef": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "version": {
          "$ref": "#/$defs/version"
        }
      },
      "required": [
        "id",
        "version"
      ]
    },
    "typedRef": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "kind": {
          "enum": [
            "object",
            "relation",
            "condition",
            "pathway",
            "temporal_requirement",
            "link"
          ]
        },
        "id": {
          "$ref": "#/$defs/id"
        },
        "owner_id": {
          "$ref": "#/$defs/id"
        },
        "version": {
          "$ref": "#/$defs/version"
        }
      },
      "required": [
        "kind",
        "id",
        "version"
      ]
    },
    "focus": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "NEED"
            },
            "relation": {
              "$ref": "#/$defs/relationRef"
            }
          },
          "required": [
            "kind",
            "relation"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "CAN"
            },
            "relation": {
              "$ref": "#/$defs/relationRef"
            }
          },
          "required": [
            "kind",
            "relation"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "SCENARIO"
            },
            "scenario_id": {
              "$ref": "#/$defs/id"
            }
          },
          "required": [
            "kind",
            "scenario_id"
          ]
        }
      ]
    },
    "measure": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "value": {
          "type": "number"
        },
        "unit": {
          "type": "string",
          "minLength": 1
        },
        "method": {
          "type": "string",
          "minLength": 1
        },
        "justification": {
          "type": "string",
          "minLength": 1
        },
        "evidence_ids": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/id"
          }
        }
      },
      "required": [
        "value",
        "unit",
        "method",
        "justification"
      ]
    },
    "object": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "category": {
          "enum": [
            "individual",
            "group",
            "technical_object",
            "system",
            "semantic_object"
          ]
        },
        "label": {
          "type": "string"
        },
        "parent_id": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[A-Za-z][A-Za-z0-9._:-]*$"
        },
        "temporary_child_ids": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/id"
          }
        },
        "actualised_child_ids": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/id"
          }
        }
      },
      "required": [
        "id",
        "category",
        "parent_id",
        "temporary_child_ids",
        "actualised_child_ids"
      ]
    },
    "definition": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "object_id": {
          "$ref": "#/$defs/id"
        },
        "version": {
          "$ref": "#/$defs/version"
        },
        "constituents": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/objectRef"
          }
        },
        "properties": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "description": "Property definitions, not time-indexed actual physical values."
          }
        },
        "relation_refs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/relationRef"
          }
        },
        "notes": {
          "type": "string"
        },
        "evidence_ids": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/id"
          }
        }
      },
      "required": [
        "object_id",
        "version",
        "constituents",
        "properties",
        "relation_refs"
      ]
    },
    "logic": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "ref": {
              "$ref": "#/$defs/typedRef"
            }
          },
          "required": [
            "ref"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "op": {
              "enum": [
                "all",
                "any"
              ]
            },
            "items": {
              "type": "array",
              "minItems": 1,
              "items": {
                "$ref": "#/$defs/logic"
              }
            }
          },
          "required": [
            "op",
            "items"
          ]
        }
      ],
      "description": "Shared recursive all/any grammar. Object-role, condition, time, inventory and pathway meanings are separately scoped; this is a technical design proposal."
    },
    "link": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "object_id": {
          "$ref": "#/$defs/id"
        },
        "source_list": {
          "enum": [
            "NEEDs",
            "CANs"
          ]
        },
        "roles": {
          "type": "array",
          "items": {
            "enum": [
              "contributive",
              "enabling",
              "inhibitory",
              "transformative",
              "alternative",
              "complementary",
              "substitutive",
              "sequential",
              "synergistic",
              "antagonistic",
              "reciprocal"
            ]
          }
        },
        "conditions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/typedRef"
          }
        },
        "mechanism": {
          "type": "string"
        },
        "causality": {
          "enum": [
            "direct",
            "indirect",
            "indeterminate"
          ]
        },
        "evidence_claim_id": {
          "$ref": "#/$defs/id"
        },
        "affects": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/id"
          }
        },
        "weight": {
          "type": "number",
          "minimum": 0
        }
      },
      "required": [
        "id",
        "object_id",
        "source_list"
      ]
    },
    "temporalRequirement": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "target": {
          "enum": [
            "satisfaction",
            "action_start",
            "action_completion",
            "effect",
            "relation_applicability"
          ]
        },
        "mode": {
          "enum": [
            "point",
            "continuous",
            "deadline",
            "recurring",
            "cumulative"
          ]
        },
        "at": {
          "$ref": "#/$defs/time"
        },
        "deadline": {
          "$ref": "#/$defs/time"
        },
        "window": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "start": {
              "$ref": "#/$defs/time"
            },
            "end": {
              "$ref": "#/$defs/time"
            }
          },
          "required": [
            "start",
            "end"
          ]
        },
        "recurrence": {
          "type": "object"
        },
        "min_duration": {
          "type": "string",
          "pattern": "^P"
        },
        "description": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "target",
        "mode"
      ]
    },
    "temporalEstimate": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "target": {
          "enum": [
            "execution",
            "effect"
          ]
        },
        "duration": {
          "type": "object"
        },
        "start_delay": {
          "type": "object"
        }
      },
      "required": [
        "target"
      ]
    },
    "temporal": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "time_zone": {
          "type": "string",
          "minLength": 1
        },
        "requirements": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/temporalRequirement"
          }
        },
        "composition": {
          "$ref": "#/$defs/logic"
        },
        "estimates": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/temporalEstimate"
          }
        }
      },
      "required": [
        "time_zone",
        "requirements",
        "estimates"
      ]
    },
    "relation": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "version": {
          "$ref": "#/$defs/version"
        },
        "type": {
          "enum": [
            "NEED",
            "CAN"
          ]
        },
        "origin_object": {
          "$ref": "#/$defs/objectRef"
        },
        "NEEDs": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "array",
              "items": {
                "$ref": "#/$defs/objectRef"
              }
            }
          ]
        },
        "CANs": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "array",
              "items": {
                "$ref": "#/$defs/objectRef"
              }
            }
          ]
        },
        "relation": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "nature": {
              "type": "array",
              "items": {
                "enum": [
                  "existential",
                  "structural",
                  "functional",
                  "contributive",
                  "enabling",
                  "inhibitory",
                  "transformative"
                ]
              }
            },
            "links": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/link"
              }
            },
            "composition": {
              "$ref": "#/$defs/logic"
            },
            "notes": {
              "type": "string"
            }
          },
          "required": [
            "nature",
            "links"
          ]
        },
        "temporal": {
          "$ref": "#/$defs/temporal"
        },
        "required_state": {
          "type": "object"
        },
        "description": {
          "type": "string"
        },
        "represented_object": {
          "$ref": "#/$defs/objectRef",
          "description": "PROPOSED: identity of the NEED/CAN as an Object, distinct from the relation-record ID and its origin Object; D-36/D-2026-11-16 mapping requires review."
        }
      },
      "required": [
        "id",
        "version",
        "type",
        "represented_object",
        "origin_object",
        "NEEDs",
        "CANs",
        "relation"
      ]
    },
    "predicate": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "object": {
          "$ref": "#/$defs/objectRef"
        },
        "property": {
          "type": "string",
          "minLength": 1
        },
        "operator": {
          "enum": [
            "equals",
            "not_equals",
            "exists",
            "greater_than",
            "greater_or_equal",
            "less_than",
            "less_or_equal"
          ]
        },
        "value": {}
      },
      "required": [
        "object",
        "property",
        "operator"
      ]
    },
    "condition": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "owner_relation": {
          "$ref": "#/$defs/relationRef"
        },
        "target": {
          "enum": [
            "actionability",
            "need_satisfaction",
            "relation_applicability"
          ]
        },
        "predicate": {
          "$ref": "#/$defs/predicate"
        },
        "temporal": {
          "$ref": "#/$defs/temporal"
        },
        "notes": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "owner_relation",
        "target",
        "predicate"
      ]
    },
    "pathway": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "version": {
          "$ref": "#/$defs/version"
        },
        "owner_relation": {
          "$ref": "#/$defs/relationRef"
        },
        "coverage": {
          "$ref": "#/$defs/coverage"
        },
        "expression": {
          "$ref": "#/$defs/logic"
        },
        "evidence_claim_id": {
          "$ref": "#/$defs/id"
        },
        "scope": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "version",
        "owner_relation",
        "coverage",
        "expression"
      ]
    },
    "inventory": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "version": {
          "$ref": "#/$defs/version"
        },
        "owner_relation": {
          "$ref": "#/$defs/relationRef"
        },
        "coverage": {
          "$ref": "#/$defs/coverage"
        },
        "search_status": {
          "enum": [
            "not_searched",
            "searched_no_match",
            "candidates_identified"
          ]
        },
        "expression": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/logic"
            }
          ]
        },
        "scope": {
          "type": "string"
        },
        "evidence_claim_id": {
          "$ref": "#/$defs/id"
        }
      },
      "required": [
        "id",
        "version",
        "owner_relation",
        "coverage",
        "search_status",
        "expression"
      ]
    },
    "objectState": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "object": {
          "$ref": "#/$defs/objectRef"
        },
        "at": {
          "$ref": "#/$defs/time"
        },
        "basis": {
          "enum": [
            "observed",
            "simulated",
            "assumed"
          ]
        },
        "values": {
          "type": "object",
          "additionalProperties": true
        },
        "evidence_ids": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/id"
          }
        }
      },
      "required": [
        "object",
        "at",
        "basis",
        "values"
      ]
    },
    "scenario": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "parent_scenario_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "mode": {
          "enum": [
            "hypothetical",
            "effective"
          ]
        },
        "object_heads": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/objectRef"
          }
        },
        "states": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/objectState"
          }
        },
        "event_ids": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/id"
          }
        },
        "assumptions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "notes": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "parent_scenario_id",
        "mode",
        "object_heads",
        "states",
        "event_ids"
      ]
    },
    "stateChange": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "object": {
          "$ref": "#/$defs/objectRef"
        },
        "property": {
          "type": "string",
          "minLength": 1
        },
        "before": {},
        "after": {},
        "at": {
          "$ref": "#/$defs/time"
        }
      },
      "required": [
        "object",
        "property",
        "after"
      ]
    },
    "event": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "scenario_id": {
          "$ref": "#/$defs/id"
        },
        "kind": {
          "enum": [
            "simulated_actualization",
            "effective_actualization",
            "observation",
            "knowledge_revision",
            "definition_revision"
          ]
        },
        "at": {
          "$ref": "#/$defs/time"
        },
        "source_can": {
          "$ref": "#/$defs/relationRef"
        },
        "state_changes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/stateChange"
          }
        },
        "evidence_ids": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/id"
          }
        },
        "notes": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "scenario_id",
        "kind",
        "at",
        "state_changes"
      ],
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {
                "enum": [
                  "observation",
                  "knowledge_revision",
                  "definition_revision"
                ]
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "properties": {
              "state_changes": {
                "maxItems": 0
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "enum": [
                  "simulated_actualization",
                  "effective_actualization"
                ]
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "required": [
              "source_can"
            ]
          }
        }
      ]
    },
    "conditionAssessment": {
      "type": "object",
      "additionalProperties": false,
