{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:trialectic:schema:power-evaluation:structural-boundaries-v0",
  "title": "PowerEvaluation — partial structural contract (D-57, D-61–D-68)",
  "description": "Executable Draft 2020-12 boundary schema: D-57/D-66 six exact top-level fields; D-67 Focus discriminator and references; D-61–D-63 Focus-specific Results sections; and D-68 Subject, Context and Dependencies local structure. Nested Results formats, ID and Focus identifier string formats, temporal metadata and cross-record semantic checks remain OPEN. Passing this partial schema does NOT establish full structural, semantic or empirical validity.",
  "type": "object",
  "required": [
    "ID",
    "Subject",
    "Focus",
    "Context",
    "Dependencies",
    "Results"
  ],
  "additionalProperties": false,
  "properties": {
    "ID": true,
    "Subject": {
      "type": "object",
      "required": [
        "object_id"
      ],
      "properties": {
        "object_id": {
          "$ref": "#/$defs/nonEmptyString"
        }
      }
    },
    "Focus": {
      "type": "object",
      "required": [
        "type"
      ],
      "description": "D-67 approves case-sensitive type and type-specific reference presence. ID syntax/types and additional nested metadata remain OPEN.",
      "oneOf": [
        {
          "properties": {
            "type": {
              "const": "NEED"
            }
          },
          "required": [
            "object_id"
          ],
          "not": {
            "required": [
              "scenario_id"
            ]
          }
        },
        {
          "properties": {
            "type": {
              "const": "CAN"
            }
          },
          "required": [
            "object_id"
          ],
          "not": {
            "required": [
              "scenario_id"
            ]
          }
        },
        {
          "properties": {
            "type": {
              "const": "Scenario"
            }
          },
          "required": [
            "scenario_id"
          ],
          "not": {
            "required": [
              "object_id"
            ]
          }
        }
      ]
    },
    "Context": {
      "type": "object",
      "required": [
        "definition_versions"
      ],
      "properties": {
        "scenario_id": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "definition_versions": {
          "type": "object",
          "minProperties": 1,
          "propertyNames": {
            "$ref": "#/$defs/nonEmptyString"
          },
          "additionalProperties": {
            "$ref": "#/$defs/nonEmptyString"
          }
        },
        "provenance": {
          "type": "object",
          "properties": {
            "revises": {
              "$ref": "#/$defs/nonEmptyString"
            }
          }
        }
      }
    },
    "Dependencies": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "evaluation_id"
        ],
        "properties": {
          "evaluation_id": {
            "$ref": "#/$defs/nonEmptyString"
          }
        }
      }
    },
    "Results": {
      "type": "object"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "Focus": {
            "type": "object",
            "properties": {
              "type": {
                "const": "NEED"
              }
            },
            "required": [
              "type"
            ]
          }
        },
        "required": [
          "Focus"
        ]
      },
      "then": {
        "properties": {
          "Results": {
            "$ref": "#/$defs/needResults"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "Focus": {
            "type": "object",
            "properties": {
              "type": {
                "const": "CAN"
              }
            },
            "required": [
              "type"
            ]
          }
        },
        "required": [
          "Focus"
        ]
      },
      "then": {
        "properties": {
          "Results": {
            "$ref": "#/$defs/canResults"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "Focus": {
            "type": "object",
            "properties": {
              "type": {
                "const": "Scenario"
              }
            },
            "required": [
              "type"
            ]
          }
        },
        "required": [
          "Focus"
        ]
      },
      "then": {
        "properties": {
          "Results": {
            "$ref": "#/$defs/scenarioResults"
          }
        }
      }
    }
  ],
  "$defs": {
    "needResults": {
      "type": "object",
      "required": [
        "effective_satisfaction",
        "temporal_compliance",
        "candidate_cans"
      ],
      "not": {
        "anyOf": [
          {
            "required": [
              "actualizability"
            ]
          },
          {
            "required": [
              "prerequisites"
            ]
          },
          {
            "required": [
              "potential_contributions"
            ]
          },
          {
            "required": [
              "actualization_assessments"
            ]
          },
          {
            "required": [
              "scenario_assessment"
            ]
          },
          {
            "required": [
              "effects"
            ]
          },
          {
            "required": [
              "comparisons"
            ]
          }
        ]
      }
    },
    "canResults": {
      "type": "object",
      "required": [
        "actualizability",
        "prerequisites",
        "potential_contributions"
      ],
      "not": {
        "anyOf": [
          {
            "required": [
              "effective_satisfaction"
            ]
          },
          {
            "required": [
              "temporal_compliance"
            ]
          },
          {
            "required": [
              "candidate_cans"
            ]
          },
          {
            "required": [
              "actualization_assessments"
            ]
          },
          {
            "required": [
              "scenario_assessment"
            ]
          },
          {
            "required": [
              "effects"
            ]
          },
          {
            "required": [
              "comparisons"
            ]
          }
        ]
      }
    },
    "scenarioResults": {
      "type": "object",
      "required": [
        "actualization_assessments",
        "scenario_assessment",
        "effects",
        "comparisons"
      ],
      "not": {
        "anyOf": [
          {
            "required": [
              "effective_satisfaction"
            ]
          },
          {
            "required": [
              "temporal_compliance"
            ]
          },
          {
            "required": [
              "candidate_cans"
            ]
          },
          {
            "required": [
              "actualizability"
            ]
          },
          {
            "required": [
              "prerequisites"
            ]
          },
          {
            "required": [
              "potential_contributions"
            ]
          }
        ]
      }
    },
    "nonEmptyString": {
      "type": "string",
      "minLength": 1
    }
  }
}
