{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:trialectic:schema:power-evaluation:structural-boundaries-v0",
  "title": "PowerEvaluation — partial structural contract (D-57, D-61–D-70)",
  "description": "Executable Draft 2020-12 partial boundary schema: six-field top-level, D-67 Focus, D-68 typed Subject/Context/Dependencies, D-61–D-63 Focus-specific Results section names, D-69 NEED effective_satisfaction and D-70 NEED temporal_compliance applicability/status. Full nested candidate CAN/CAN/Scenario results, exception authorization, temporal engine, evidence quality and cross-record semantic validation remain OPEN.",
  "type": "object",
  "required": [
    "ID",
    "Subject",
    "Focus",
    "Context",
    "Dependencies",
    "Results"
  ],
  "additionalProperties": false,
  "properties": {
    "ID": true,
    "Subject": {
      "type": "object",
      "required": [
        "object_id"
      ],
      "properties": {
        "object_id": {
          "$ref": "#/$defs/nonEmptyString"
        }
      }
    },
    "Focus": {
      "type": "object",
      "required": [
        "type"
      ],
      "description": "D-67 approves case-sensitive type and type-specific reference presence. ID syntax/types and additional nested metadata remain OPEN.",
      "oneOf": [
        {
          "properties": {
            "type": {
              "const": "NEED"
            }
          },
          "required": [
            "object_id"
          ],
          "not": {
            "required": [
              "scenario_id"
            ]
          }
        },
        {
          "properties": {
            "type": {
              "const": "CAN"
            }
          },
          "required": [
            "object_id"
          ],
          "not": {
            "required": [
              "scenario_id"
            ]
          }
        },
        {
          "properties": {
            "type": {
              "const": "Scenario"
            }
          },
          "required": [
            "scenario_id"
          ],
          "not": {
            "required": [
              "object_id"
            ]
          }
        }
      ]
    },
    "Context": {
      "type": "object",
      "required": [
        "definition_versions"
      ],
      "properties": {
        "scenario_id": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "definition_versions": {
          "type": "object",
          "minProperties": 1,
          "propertyNames": {
            "$ref": "#/$defs/nonEmptyString"
          },
          "additionalProperties": {
            "$ref": "#/$defs/nonEmptyString"
          }
        },
        "provenance": {
          "type": "object",
          "properties": {
            "revises": {
              "$ref": "#/$defs/nonEmptyString"
            }
          }
        }
      }
    },
    "Dependencies": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "evaluation_id"
        ],
        "properties": {
          "evaluation_id": {
            "$ref": "#/$defs/nonEmptyString"
          }
        }
      }
    },
    "Results": {
      "type": "object"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "Focus": {
            "type": "object",
            "properties": {
              "type": {
                "const": "NEED"
              }
            },
            "required": [
              "type"
            ]
          }
        },
        "required": [
          "Focus"
        ]
      },
      "then": {
        "properties": {
          "Results": {
            "$ref": "#/$defs/needResults"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "Focus": {
            "type": "object",
            "properties": {
              "type": {
                "const": "CAN"
              }
            },
            "required": [
              "type"
            ]
          }
        },
        "required": [
          "Focus"
        ]
      },
      "then": {
        "properties": {
          "Results": {
            "$ref": "#/$defs/canResults"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "Focus": {
            "type": "object",
            "properties": {
              "type": {
                "const": "Scenario"
              }
            },
            "required": [
              "type"
            ]
          }
        },
        "required": [
          "Focus"
        ]
      },
      "then": {
        "properties": {
          "Results": {
            "$ref": "#/$defs/scenarioResults"
          }
        }
      }
    }
  ],
  "$defs": {
    "needResults": {
      "type": "object",
      "required": [
        "effective_satisfaction",
        "temporal_compliance",
        "candidate_cans"
      ],
      "not": {
        "anyOf": [
          {
            "required": [
              "actualizability"
            ]
          },
          {
            "required": [
              "prerequisites"
            ]
          },
          {
            "required": [
              "potential_contributions"
            ]
          },
          {
            "required": [
              "actualization_assessments"
            ]
          },
          {
            "required": [
              "scenario_assessment"
            ]
          },
          {
            "required": [
              "effects"
            ]
          },
          {
            "required": [
              "comparisons"
            ]
          }
        ]
      },
      "properties": {
        "effective_satisfaction": {
          "$ref": "#/$defs/needEffectiveSatisfaction"
        },
        "temporal_compliance": {
          "$ref": "#/$defs/needTemporalCompliance"
        }
      }
    },
    "canResults": {
      "type": "object",
      "required": [
        "actualizability",
        "prerequisites",
        "potential_contributions"
      ],
      "not": {
        "anyOf": [
          {
            "required": [
              "effective_satisfaction"
            ]
          },
          {
            "required": [
              "temporal_compliance"
            ]
          },
          {
            "required": [
              "candidate_cans"
            ]
          },
          {
            "required": [
              "actualization_assessments"
            ]
          },
          {
            "required": [
              "scenario_assessment"
            ]
          },
          {
            "required": [
              "effects"
            ]
          },
          {
            "required": [
              "comparisons"
            ]
          }
        ]
      }
    },
    "scenarioResults": {
      "type": "object",
      "required": [
        "actualization_assessments",
        "scenario_assessment",
        "effects",
        "comparisons"
      ],
      "not": {
        "anyOf": [
          {
            "required": [
              "effective_satisfaction"
            ]
          },
          {
            "required": [
              "temporal_compliance"
            ]
          },
          {
            "required": [
              "candidate_cans"
            ]
          },
          {
            "required": [
              "actualizability"
            ]
          },
          {
            "required": [
              "prerequisites"
            ]
          },
          {
            "required": [
              "potential_contributions"
            ]
          }
        ]
      }
    },
    "nonEmptyString": {
      "type": "string",
      "minLength": 1
    },
    "needEffectiveSatisfaction": {
      "type": "object",
      "description": "D-69: NEED actual satisfaction status and explanatory evidence, separate from temporal compliance. Additional nested metadata is not closed by this decision.",
      "required": [
        "status",
        "justification"
      ],
      "properties": {
        "status": {
          "type": "string",
          "enum": [
            "satisfied",
            "unsatisfied",
            "indeterminate"
          ]
        },
        "justification": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "degree": {
          "type": "object",
          "required": [
            "value",
            "measure",
            "basis"
          ],
          "description": "Optional pertinent justified measure. No universal numeric range; do not conflate degree with probability.",
          "properties": {
            "value": {
              "type": "number"
            },
            "measure": {
              "$ref": "#/$defs/nonEmptyString"
            },
            "basis": {
              "$ref": "#/$defs/nonEmptyString"
            }
          }
        },
        "evidence": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/nonEmptyString"
          }
        },
        "uncertainty": {
          "type": "object"
        }
      }
    },
    "needTemporalCompliance": {
      "type": "object",
      "description": "D-70: distinguish temporal requirement applicability from the three-state compliance result; exceptions affect compliance requirements, not effective NEED satisfaction. Extra nested metadata remains undecided.",
      "required": [
        "applicability",
        "justification"
      ],
      "properties": {
        "applicability": {
          "type": "string",
          "enum": [
            "applicable",
            "not_applicable",
            "indeterminate"
          ]
        },
        "status": {
          "type": "string",
          "enum": [
            "satisfied",
            "unsatisfied",
            "indeterminate"
          ]
        },
        "justification": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "applied_exceptions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/nonEmptyString"
          }
        },
        "evidence": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/nonEmptyString"
          }
        },
        "uncertainty": {
          "type": "object"
        }
      },
      "oneOf": [
        {
          "properties": {
            "applicability": {
              "const": "applicable"
            }
          },
          "required": [
            "status"
          ]
        },
        {
          "properties": {
            "applicability": {
              "const": "not_applicable"
            }
          },
          "not": {
            "required": [
              "status"
            ]
          }
        },
        {
          "properties": {
            "applicability": {
              "const": "indeterminate"
            },
            "status": {
              "const": "indeterminate"
            }
          }
        }
      ]
    }
  }
}
