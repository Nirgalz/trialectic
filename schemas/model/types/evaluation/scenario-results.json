{
  "scenarioResults": {
    "type": "object",
    "required": [
      "actualization_assessments",
      "scenario_assessment",
      "effects",
      "comparisons"
    ],
    "not": {
      "anyOf": [
        {
          "required": [
            "effective_satisfaction"
          ]
        },
        {
          "required": [
            "temporal_compliance"
          ]
        },
        {
          "required": [
            "candidate_cans"
          ]
        },
        {
          "required": [
            "actualizability"
          ]
        },
        {
          "required": [
            "prerequisites"
          ]
        },
        {
          "required": [
            "potential_contributions"
          ]
        }
      ]
    },
    "properties": {
      "actualization_assessments": {
        "$ref": "#/$defs/scenarioActualizationAssessments"
      },
      "scenario_assessment": {
        "$ref": "#/$defs/scenarioAssessment"
      },
      "effects": {
        "$ref": "#/$defs/scenarioEffects"
      },
      "comparisons": {
        "$ref": "#/$defs/scenarioComparisons"
      }
    }
  },
  "scenarioUncertainty": {
    "type": "object",
    "properties": {
      "justification": {
        "type": "string",
        "minLength": 1
      },
      "evidence": {
        "type": "array",
        "items": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "required": [
      "justification"
    ]
  },
  "scenarioDimension": {
    "type": "object",
    "properties": {
      "status": {
        "enum": [
          "assessed",
          "not_assessed",
          "indeterminate",
          "not_applicable"
        ]
      },
      "justification": {
        "type": "string",
        "minLength": 1
      },
      "finding": {
        "type": "string",
        "minLength": 1
      },
      "degree": {
        "$ref": "#/$defs/scenarioDegree"
      },
      "evidence": {
        "type": "array",
        "items": {
          "type": "string",
          "minLength": 1
        }
      },
      "uncertainty": {
        "$ref": "#/$defs/scenarioUncertainty"
      }
    },
    "required": [
      "status",
      "justification"
    ],
    "allOf": [
      {
        "if": {
          "properties": {
            "status": {
              "const": "assessed"
            }
          },
          "required": [
            "status"
          ]
        },
        "then": {
          "required": [
            "finding"
          ]
        }
      }
    ]
  },
  "scenarioDegree": {
    "type": "object",
    "description": "Optional justified numeric measure; no universal bounds, automatic status inference or probability interpretation.",
    "required": [
      "value",
      "measure",
      "basis"
    ],
    "properties": {
      "value": {
        "type": "number"
      },
      "measure": {
        "$ref": "#/$defs/nonEmptyString"
      },
      "basis": {
        "$ref": "#/$defs/nonEmptyString"
      }
    }
  },
  "contemplatedAssessment": {
    "type": "object",
    "properties": {
      "can_object_id": {
        "type": "string",
        "minLength": 1
      },
      "evaluation_id": {
        "type": "string",
        "minLength": 1
      },
      "contemplated_actualization": {
        "type": "string",
        "minLength": 1
      },
      "justification": {
        "type": "string",
        "minLength": 1
      },
      "step_id": {
        "type": "string",
        "minLength": 1
      },
      "evidence": {
        "type": "array",
        "items": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "required": [
      "can_object_id",
      "evaluation_id",
      "contemplated_actualization",
      "justification"
    ]
  },
  "scenarioEffectRef": {
    "type": "object",
    "properties": {
      "effect_id": {
        "type": "string",
        "minLength": 1
      },
      "justification": {
        "type": "string",
        "minLength": 1
      },
      "evidence": {
        "type": "array",
        "items": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "required": [
      "effect_id",
      "justification"
    ]
  },
  "comparisonCriterion": {
    "type": "object",
    "properties": {
      "criterion": {
        "type": "string",
        "minLength": 1
      },
      "finding": {
        "type": "string",
        "minLength": 1
      },
      "justification": {
        "type": "string",
        "minLength": 1
      },
      "evidence": {
        "type": "array",
        "items": {
          "type": "string",
          "minLength": 1
        }
      },
      "uncertainty": {
        "$ref": "#/$defs/scenarioUncertainty"
      }
    },
    "required": [
      "criterion",
      "finding",
      "justification"
    ]
  },
  "scenarioComparison": {
    "type": "object",
    "properties": {
      "scenario_id": {
        "type": "string",
        "minLength": 1
      },
      "criteria": {
        "type": "array",
        "items": {
          "$ref": "#/$defs/comparisonCriterion"
        },
        "minItems": 1
      },
      "justification": {
        "type": "string",
        "minLength": 1
      }
    },
    "required": [
      "scenario_id",
      "criteria",
      "justification"
    ]
  },
  "scenarioActualizationAssessments": {
    "type": "object",
    "properties": {
      "items": {
        "type": "array",
        "items": {
          "$ref": "#/$defs/contemplatedAssessment"
        }
      },
      "coverage": {
        "enum": [
          "complete",
          "incomplete",
          "indeterminate"
        ]
      },
      "scope": {
        "type": "string",
        "minLength": 1
      },
      "justification": {
        "type": "string",
        "minLength": 1
      },
      "evidence": {
        "type": "array",
        "items": {
          "type": "string",
          "minLength": 1
        }
      },
      "uncertainty": {
        "$ref": "#/$defs/scenarioUncertainty"
      }
    },
    "required": [
      "items",
      "coverage",
      "scope",
      "justification"
    ]
  },
  "scenarioEffects": {
    "type": "object",
    "properties": {
      "items": {
        "type": "array",
        "items": {
          "$ref": "#/$defs/scenarioEffectRef"
        }
      },
      "coverage": {
        "enum": [
          "complete",
          "incomplete",
          "indeterminate"
        ]
      },
      "scope": {
        "type": "string",
        "minLength": 1
      },
      "justification": {
        "type": "string",
        "minLength": 1
      },
      "evidence": {
        "type": "array",
        "items": {
          "type": "string",
          "minLength": 1
        }
      },
      "uncertainty": {
        "$ref": "#/$defs/scenarioUncertainty"
      }
    },
    "required": [
      "items",
      "coverage",
      "scope",
      "justification"
    ]
  },
  "scenarioComparisons": {
    "type": "object",
    "properties": {
      "items": {
        "type": "array",
        "items": {
          "$ref": "#/$defs/scenarioComparison"
        }
      },
      "coverage": {
        "enum": [
          "complete",
          "incomplete",
          "indeterminate"
        ]
      },
      "scope": {
        "type": "string",
        "minLength": 1
      },
      "justification": {
        "type": "string",
        "minLength": 1
      },
      "evidence": {
        "type": "array",
        "items": {
          "type": "string",
          "minLength": 1
        }
      },
      "uncertainty": {
        "$ref": "#/$defs/scenarioUncertainty"
      },
      "selection": {
        "type": "object",
        "properties": {
          "scenario_id": {
            "type": "string",
            "minLength": 1
          },
          "justification": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "scenario_id",
          "justification"
        ]
      }
    },
    "required": [
      "items",
      "coverage",
      "scope",
      "justification"
    ]
  },
  "scenarioAssessment": {
    "type": "object",
    "properties": {
      "feasibility": {
        "$ref": "#/$defs/scenarioDimension"
      },
      "complexity": {
        "$ref": "#/$defs/scenarioDimension"
      },
      "costs_resources": {
        "$ref": "#/$defs/scenarioDimension"
      },
      "temporality": {
        "$ref": "#/$defs/scenarioDimension"
      },
      "expected_effectiveness": {
        "$ref": "#/$defs/scenarioDimension"
      },
      "uncertainty": {
        "$ref": "#/$defs/scenarioUncertainty"
      },
      "justification": {
        "type": "string",
        "minLength": 1
      }
    },
    "required": [
      "feasibility",
      "complexity",
      "costs_resources",
      "temporality",
      "expected_effectiveness",
      "uncertainty",
      "justification"
    ]
  }
}
