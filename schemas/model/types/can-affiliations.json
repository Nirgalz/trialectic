              "indeterminate"
            ]
          },
          "scope": {
            "type": "string",
            "minLength": 1
          },
          "justification": {
            "type": "string",
            "minLength": 1
          },
          "claim_id": {
            "$ref": "#/$defs/id"
          },
          "claim_version": {
            "$ref": "#/$defs/version"
          }
        },
        "required": [
