{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:trialectic:ui-transport:tria-map-response-v2",
  "title": "Experimental trIA map response v2 — provisional UI proposals",
  "description": "Local shape only. The client adds matching analysis_id, source/overlay reference, new-ID uniqueness, represented concept_kind and first/follow-up compliance checks. Not an Analysis exchange schema and not an epistemic validator.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "analysis_id",
    "answer",
    "tria_instruction_check",
    "map_patch"
  ],
  "properties": {
    "schema": {
      "const": "tria-map-response-v2"
    },
    "analysis_id": {
      "type": "string"
    },
    "answer": {
      "type": "string",
      "minLength": 1,
      "maxLength": 20000,
      "pattern": "\\S"
    },
    "tria_instruction_check": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "message"
      ],
      "properties": {
        "status": {
          "enum": [
            "acknowledged",
            "confirmed",
            "non_compliant",
            "uncertain"
          ]
        },
        "message": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1200,
          "pattern": "\\S"
        }
      }
    },
    "map_patch": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "objects",
        "relations"
      ],
      "properties": {
        "objects": {
          "type": "array",
          "maxItems": 20,
          "items": {
            "$ref": "#/$defs/candidateObject"
          }
        },
        "relations": {
          "type": "array",
          "maxItems": 30,
          "items": {
            "$ref": "#/$defs/candidateRelation"
          }
        }
      }
    }
  },
  "$defs": {
    "candidateObject": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "label",
        "category",
        "concept_kind",
        "justification"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 5,
          "maxLength": 90,
          "pattern": "^AI-O-[A-Za-z0-9._:-]*$"
        },
        "label": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160,
          "pattern": "\\S"
        },
        "category": {
          "enum": [
            "individual",
            "group",
            "technical_object",
            "system",
            "semantic_object"
          ]
        },
        "concept_kind": {
          "enum": [
            "NEED",
            "CAN",
            null
          ]
        },
        "justification": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000,
          "pattern": "\\S"
        }
      }
    },
    "candidateRelation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "type",
        "origin_object_id",
        "represented_object_id",
        "can_object_ids",
        "need_object_ids",
        "description",
        "justification"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 5,
          "maxLength": 90,
          "pattern": "^AI-R-[A-Za-z0-9._:-]*$"
        },
        "type": {
          "enum": [
            "NEED",
            "CAN"
          ]
        },
        "origin_object_id": {
          "type": "string"
        },
        "represented_object_id": {
          "type": "string"
        },
        "can_object_ids": {
          "type": "array",
          "maxItems": 30,
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        },
        "need_object_ids": {
          "type": "array",
          "maxItems": 30,
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        },
        "description": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1600,
          "pattern": "\\S"
        },
        "justification": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000,
          "pattern": "\\S"
        }
      }
    }
  }
}
